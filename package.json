{
  "name": "dina-perles",
  "private": true,
  "description": "Outils de compilation du CSS et du JavaScript 3D. Inutile sur l'hébergement : les fichiers compilés sont dans public/assets.",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -c resources/tailwind.config.js -i resources/css/app.css -o public/assets/css/app.css --minify",
    "build:js": "esbuild resources/js/pearl3d.js --bundle --minify --format=esm --target=es2020 --legal-comments=eof --outfile=public/assets/js/pearl3d.js && cp node_modules/lenis/dist/lenis.min.js public/assets/vendor/lenis.min.js",
    "watch:css": "tailwindcss -c resources/tailwind.config.js -i resources/css/app.css -o public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "lenis": "1.3.26",
    "tailwindcss": "3.4.17",
    "three": "0.186.0"
  }
}
