# Copiez ce fichier en .env et renseignez vos valeurs :  cp .env.example .env
# Le fichier .env est ignoré par Git : ne mettez jamais de mot de passe dans le dépôt.

# true uniquement en local : affiche le détail des erreurs PHP.
APP_DEBUG=false
# Laisser vide si le site est à la racine du domaine, sinon ex. /boutique
APP_BASE_PATH=

# Base de données MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dina_perles
DB_USER=dina
DB_PASSWORD=change-moi

# Numéro WhatsApp au format international, sans + ni espaces
BRAND_WHATSAPP=22990000000
BRAND_EMAIL=bonjour@dinaperles.com
